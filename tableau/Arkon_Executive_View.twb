      <aliases enabled='yes' />
      <column caption='Window (minutes)' datatype='integer' name='[acknowledge_due_minutes]' role='measure' type='quantitative' />
      <column caption='Assignee' datatype='string' name='[assigned_to]' role='dimension' type='nominal' />
      <column caption='Domain' datatype='string' name='[business_domain]' role='dimension' type='nominal' />
      <column caption='Raised at' datatype='string' name='[created_at]' role='dimension' type='nominal' />
      <column caption='Raised' datatype='string' name='[created_local]' role='dimension' type='nominal' />
      <column caption='Incident' datatype='string' name='[incident_id]' role='dimension' type='nominal' />
      <column caption='Minutes to acknowledge' datatype='real' name='[minutes_to_acknowledge]' role='measure' type='quantitative' />
      <column caption='Priority' datatype='string' name='[priority]' role='dimension' type='nominal' />
      <column caption='Model' datatype='string' name='[source_module]' role='dimension' type='nominal' />
      <column caption='Status' datatype='string' name='[status]' role='dimension' type='nominal' />
      <column caption='Summary' datatype='string' name='[summary]' role='dimension' type='nominal' />
      <column caption='Incidents' datatype='integer' name='[Calculation_101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([incident_id])' />
      </column>
      <column caption='Open?' datatype='string' name='[Calculation_103]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_open] THEN &quot;Open&quot; ELSE &quot;Closed&quot; END' />
      </column>
      <column caption='Open incidents' datatype='integer' name='[Calculation_106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_open] THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Age (hours)' datatype='string' name='[Calculation_108]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(SUM([age_minutes]) / 60, 1)) + &quot; h&quot;' />
      </column>
      <column caption='Age band' datatype='string' name='[Calculation_130]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age_minutes] &lt; 60 THEN &quot;under 1 h&quot; ELSEIF [age_minutes] &lt; 240 THEN &quot;1 to 4 h&quot; ELSEIF [age_minutes] &lt; 1440 THEN &quot;4 to 24 h&quot; ELSEIF [age_minutes] &lt; 4320 THEN &quot;1 to 3 d&quot; ELSE &quot;over 3 d&quot; END' />
      </column>
      <column caption='Aging segment' datatype='string' name='[Calculation_131]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [overdue] THEN &quot;Overdue&quot; ELSE [priority] END' />
      </column>
      <column caption='Window' datatype='real' name='[Calculation_140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[acknowledge_due_minutes] / [acknowledge_due_minutes]' />
      </column>
      <column caption='Acknowledge ratio' datatype='real' name='[Calculation_141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([minutes_to_acknowledge] / [acknowledge_due_minutes], 4.0)' />
      </column>
      <column caption='Acknowledge segment' datatype='string' name='[Calculation_142]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [minutes_to_acknowledge] &gt; [acknowledge_due_minutes] THEN &quot;Late&quot; ELSE [priority] END' />
      </column>
      <column caption='Incident' datatype='string' name='[Calculation_143]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE([incident_id], &quot;ARK-INC-&quot;, &quot;&quot;) + &quot; / &quot; + [priority]' />
      </column>
      <column caption='Has window' datatype='boolean' name='[Calculation_144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([minutes_to_acknowledge]) AND [acknowledge_due_minutes] &gt; 0' />
      </column>
      <column caption='Minutes to acknowledge' datatype='string' name='[Calculation_145]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([minutes_to_acknowledge]) &lt; 1 THEN &quot;under 1 min&quot; ELSE STR(INT(ROUND(SUM([minutes_to_acknowledge]), 0))) + &quot; min&quot; END' />
      </column>
      <column caption='Ratio to window' datatype='string' name='[Calculation_146]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([minutes_to_acknowledge]) / SUM([acknowledge_due_minutes]) &gt; 4.0 THEN &quot;&gt;4x&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Overdue incidents' datatype='integer' name='[Calculation_120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [overdue] THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Overdue context' datatype='string' name='[Calculation_121]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_106] &gt; 0 THEN &quot;of &quot; + STR([Calculation_106]) + &quot; open, &quot; + STR(INT(ROUND([Calculation_120] / [Calculation_106] * 100))) + &quot; percent&quot; ELSE &quot;no open incidents&quot; END' />
      </column>
      <column caption='Closed or dismissed' datatype='integer' name='[Calculation_122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &quot;closed&quot; OR [status] = &quot;false_positive&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Resolved awaiting closure' datatype='integer' name='[Calculation_123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &quot;resolved&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Open context' datatype='string' name='[Calculation_124]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR([Calculation_101]) + &quot; raised, &quot; + STR([Calculation_122]) + &quot; closed&quot; + IF [Calculation_123] &gt; 0 THEN &quot;, &quot; + STR([Calculation_123]) + &quot; resolved&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Median minutes to acknowledge' datatype='real' name='[Calculation_125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([minutes_to_acknowledge])' />
      </column>
      <column caption='Time to acknowledge' datatype='string' name='[Calculation_126]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_125]) THEN &quot;none yet&quot; ELSE STR(ROUND([Calculation_125], 1)) + &quot; min&quot; END' />
      </column>
      <column caption='Response windows' datatype='string' name='[Calculation_127]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAX(&quot;median, window 15 min P1 / 60 min P2&quot;)' />
      </column>
      <column caption='Median minutes to close' datatype='real' name='[Calculation_128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([minutes_to_close])' />
      </column>
      <column caption='Time to close' datatype='string' name='[Calculation_129]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_128]) THEN &quot;none yet&quot; ELSE STR(ROUND([Calculation_128], 1)) + &quot; min&quot; END' />
      </column>
      <column caption='Closed context' datatype='string' name='[Calculation_133]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;median over &quot; + STR(SUM(IF ISNULL([minutes_to_close]) THEN 0 ELSE 1 END)) + &quot; closed&quot;' />
      </column>
      <column caption='Slowest acknowledgements' datatype='boolean' name='[Calculation_147]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[minutes_to_acknowledge] &gt;= 111.4' />
      </column>
