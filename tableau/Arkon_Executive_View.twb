      <aliases enabled='yes' />
      <column caption='Window (minutes)' datatype='integer' name='[acknowledge_due_minutes]' role='measure' type='quantitative' />
      <column caption='Assignee' datatype='string' name='[assigned_to]' role='dimension' type='nominal' />
      <column caption='Domain' datatype='string' name='[business_domain]' role='dimension' type='nominal' />
      <column caption='Raised at' datatype='string' name='[created_at]' role='dimension' type='nominal' />
      <column caption='Incident' datatype='string' name='[incident_id]' role='dimension' type='nominal' />
      <column caption='Minutes to acknowledge' datatype='real' name='[minutes_to_acknowledge]' role='measure' type='quantitative' />
      <column caption='Priority' datatype='string' name='[priority]' role='dimension' type='nominal' />
      <column caption='Model' datatype='string' name='[source_module]' role='dimension' type='nominal' />
      <column caption='Status' datatype='string' name='[status]' role='dimension' type='nominal' />
      <column caption='Summary' datatype='string' name='[summary]' role='dimension' type='nominal' />
      <column caption='Incidents' datatype='integer' name='[Calculation_101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([incident_id])' />
      </column>
      <column caption='Response state' datatype='string' name='[Calculation_102]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [overdue] THEN &quot;Overdue&quot; ELSE &quot;Within window&quot; END' />
      </column>
      <column caption='Open?' datatype='string' name='[Calculation_103]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_open] THEN &quot;Open&quot; ELSE &quot;Closed&quot; END' />
      </column>
      <column caption='Has acknowledge time' datatype='string' name='[Calculation_104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([minutes_to_acknowledge]) THEN &quot;no&quot; ELSE &quot;yes&quot; END' />
      </column>
      <column caption='Acknowledge state' datatype='string' name='[Calculation_105]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [minutes_to_acknowledge] &gt; [acknowledge_due_minutes] THEN &quot;Late&quot; ELSE &quot;In window&quot; END' />
      </column>
      <column caption='Open incidents' datatype='integer' name='[Calculation_106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_open] THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Open by priority' datatype='string' name='[Calculation_107]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(SUM(IF [is_open] AND [priority] = &quot;P1&quot; THEN 1 ELSE 0 END)) + &quot; P1, &quot; + STR(SUM(IF [is_open] AND [priority] = &quot;P2&quot; THEN 1 ELSE 0 END)) + &quot; P2, &quot; + STR(SUM(IF [is_open] AND [priority] = &quot;P3&quot; THEN 1 ELSE 0 END)) + &quot; P3&quot;' />
      </column>
      <column caption='Age (hours)' datatype='string' name='[Calculation_108]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(SUM([age_minutes]) / 60, 1)) + &quot; h&quot;' />
      </column>
      <column caption='Priority filter' datatype='boolean' name='[Calculation_110]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;All&quot; OR [priority] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Model filter' datatype='boolean' name='[Calculation_111]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;All&quot; OR [source_module] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Status filter' datatype='boolean' name='[Calculation_112]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3] = &quot;All&quot; OR [status] = [Parameters].[Parameter 3]' />
      </column>
      <column caption='Overdue incidents' datatype='integer' name='[Calculation_120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [overdue] THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Overdue context' datatype='string' name='[Calculation_121]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_106] &gt; 0 THEN &quot;of &quot; + STR([Calculation_106]) + &quot; open, &quot; + STR(INT(ROUND([Calculation_120] / [Calculation_106] * 100))) + &quot; percent&quot; ELSE &quot;no open incidents&quot; END' />
      </column>
      <column caption='Acknowledged incidents' datatype='integer' name='[Calculation_122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF ISNULL([minutes_to_acknowledge]) THEN 0 ELSE 1 END)' />
      </column>
      <column caption='Acknowledged within window' datatype='integer' name='[Calculation_123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [minutes_to_acknowledge] &lt;= [acknowledge_due_minutes] THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Acknowledged context' datatype='string' name='[Calculation_124]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;of &quot; + STR([Calculation_122]) + &quot; acknowledged, &quot; + STR([Calculation_122] - [Calculation_123]) + &quot; late&quot;' />
      </column>
      <column caption='Median minutes to acknowledge' datatype='real' name='[Calculation_125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([minutes_to_acknowledge])' />
      </column>
      <column caption='Median hours to acknowledge' datatype='string' name='[Calculation_126]' role='measure' type='nominal'>
