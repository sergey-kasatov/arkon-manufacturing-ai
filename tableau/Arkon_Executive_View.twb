    </color-palette>
  </preferences>
  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='Priority' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
        <calculation class='tableau' formula='&quot;All&quot;' />
        <members>
          <member value='&quot;All&quot;' />
          <member value='&quot;P1&quot;' />
          <member value='&quot;P2&quot;' />
          <member value='&quot;P3&quot;' />
        </members>
      </column>
      <column caption='Model' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
        <calculation class='tableau' formula='&quot;All&quot;' />
        <members>
          <member value='&quot;All&quot;' />
          <member value='&quot;casting_cv&quot;' />
          <member value='&quot;cmapss_rul&quot;' />
          <member value='&quot;gc10_detect&quot;' />
          <member value='&quot;mvtec_anomaly&quot;' />
          <member value='&quot;neu_surface&quot;' />
          <member value='&quot;nhtsa_nlp&quot;' />
          <member value='&quot;scania_aps&quot;' />
        </members>
      </column>
      <column caption='Status' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
        <calculation class='tableau' formula='&quot;All&quot;' />
        <members>
          <member value='&quot;All&quot;' />
          <member value='&quot;acknowledged&quot;' />
          <member value='&quot;closed&quot;' />
          <member value='&quot;false_positive&quot;' />
          <member value='&quot;new&quot;' />
        </members>
      </column>
    </datasource>
    <datasource caption='Arkon incidents' inline='true' name='federated.arkonincidents' version='18.1'>
      <connection class='federated'>
        <named-connections>
