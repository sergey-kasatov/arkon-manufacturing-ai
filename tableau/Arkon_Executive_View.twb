      <column caption='State' datatype='string' name='[to_status]' role='dimension' type='nominal' />
      <column caption='Transitions' datatype='integer' name='[Calculation_301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([transition_id])' />
      </column>
      <column caption='Move' datatype='string' name='[Calculation_320]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAX([from_status] + &quot; to &quot; + [to_status])' />
      </column>
      <column caption='Incident' datatype='string' name='[Calculation_321]' role='dimension' type='nominal'>
