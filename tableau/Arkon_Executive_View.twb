      <color>#2B5180</color>
      <color>#46709E</color>
      <color>#5F86AF</color>
    </color-palette>
  </preferences>
  <datasources>
    <datasource caption='Arkon incidents' inline='true' name='federated.arkonincidents' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='incidents' name='textscan.arkonincidents'>
            <connection class='textscan' directory='D:/-PROJECTS/--Portfolio/arkon-manufacturing-ai/tableau/extracts' filename='incidents.csv' is-single-table-union='yes' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.arkonincidents' name='incidents.csv' table='[incidents#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
