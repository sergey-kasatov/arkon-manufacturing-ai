<?xml version='1.0'?>

<!-- Kept in step with the palette build_workbook.py embeds. The workbook does
     not need this file to render correctly - it carries its own copy - but
     Tableau merges a same-named local palette over the embedded one when a
     workbook is SAVED from the application, so a stale definition here comes
     back as the v2 colours on the next hand save. Section 9 of
     Dashboard_Design_v3.md owns these values. -->
<workbook>
  <preferences>
    <color-palette name="Arkon status" type="regular">
      <color>#C0392B</color>
      <color>#1F3A63</color>
      <color>#3D6394</color>
      <color>#8AA6C8</color>
      <color>#B9C6D8</color>
    </color-palette>
  </preferences>
</workbook>
