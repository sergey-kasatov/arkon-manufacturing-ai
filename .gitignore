# Datasets: third-party data, restored with data/download_datasets.sh.
# Two files exceed the GitHub 100 MB limit, so the raw data never goes in git.
data/*
!data/README.md
!data/download_datasets.sh

# MLflow tracking store and artifacts
mlruns/
mlflow.db

# Trained models and checkpoints. Weights are large and regenerable from the
# training scripts, so they stay out of git.
models/**

# Exception: the seven metrics files. Every model card cites their numbers and
# every README figure is generated from them by tools/make_result_plots.py, so
# without them a clone carries a generator with no input. Named one by one and
# not by pattern - the two small *_meta.json beside the CMAPSS one belong to the
# FD001-only run that docs/Model_Card_CMAPSS_RUL.md records as superseded.
!models/checkpoints/
!models/checkpoints/*/
!models/checkpoints/casting/casting_cv_meta.json
!models/checkpoints/cmapss/cmapss_full_fleet_meta.json
!models/checkpoints/scania/scania_aps_meta.json
!models/checkpoints/neu/neu_cv_meta.json
!models/checkpoints/mvtec/mvtec_cv_meta.json
!models/checkpoints/gc10/gc10_cv_meta.json
!models/checkpoints/nhtsa/nhtsa_nlp_meta.json

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Environments and secrets
.env
.streamlit/secrets.toml
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Backups and file-transfer artefacts
*.bak
*.bak-*
.smbdelete*
sed??????

# OS
.DS_Store
Thumbs.db

# Langflow component templates, fetched from the running instance by
# langflow/build/fetch_specs.py. Generated, and large.
langflow/build/spec_*.json

# Tableau extracts. Binary, rebuilt in seconds by tableau/build_workbook.py from
# the committed CSVs, and referenced by absolute path from the workbook, so a
# committed copy would neither diff nor open from another clone. The Hyper
# daemon's log stays out too; the generator points it at the temp directory.
tableau/extracts/*.hyper
hyperd.log
# The packaged .twbx is the same workbook zipped with those extracts: a binary
# that regenerates with them. The .twb beside it is the tracked source.
tableau/*.twbx
# Tableau's own recovery copies, written beside an open workbook and left behind when
# the process dies instead of closing.
tableau/~*.twbr

# The live plant's ledger: what live_plant/plant.py sent, what intake answered and
# what the crew moved. Runtime state of one machine, like the n8n counters.
live_plant/state/
